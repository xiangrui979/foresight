{
  "name": "@foresight/memory",
  "description": "ForeSight: a temporal-aspect long-term memory plugin for DeepSeek Harness (dsh)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./schema": {
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    },
    "./store": {
      "types": "./lib/store.d.ts",
      "default": "./lib/store.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./inject": {
      "types": "./lib/inject/render.d.ts",
      "default": "./lib/inject/render.js"
    },
    "./observer": {
      "types": "./lib/ingest/observer.d.ts",
      "default": "./lib/ingest/observer.js"
    },
    "./nudge": {
      "types": "./lib/nudge/nudge.d.ts",
      "default": "./lib/nudge/nudge.js"
    },
    "./server": {
      "types": "./lib/server/server.d.ts",
      "default": "./lib/server/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.1.0",
    "sqlite-vec": "^0.1.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
